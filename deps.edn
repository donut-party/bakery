{:paths ["src"]
 :deps  {com.nextjournal/beholder {:mvn/version "1.0.0"}
         nrepl/nrepl              {:mvn/version "1.3.1"}
         org.clojure/clojure      {:mvn/version "1.12.4"}
         party.donut/system       {:mvn/version "1.0.258"}}

 :donut/lib {:name           party.donut/bakery
             :description    "one-JVM dev runner and release build for donut apps: backend, embedded shadow-cljs, nREPL and :donut/scripts, with backend routes shared in memory"
             :github         "donut-party/bakery"
             :version-prefix "1.0"}

 :aliases
 {:dev
  {:extra-deps {party.donut/system {:local/root "../system"}}
   :extra-paths ["dev" "test"]}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :exec-fn     cognitect.test-runner.api/test}

  :build
  {:deps       {io.github.donut-party/framework-build
                {:git/tag "v1" :git/sha "912e0b0"}}
   :ns-default donut.build}}}
